# Google OAuth client (from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Populated by `npm run setup:google` after a one-time browser sign-in.
# Treat this like a password.
GOOGLE_REFRESH_TOKEN=

# GA4 Property ID (numeric, from Admin -> Property details).
GA4_PROPERTY_ID=

# Google Search Console site, exact string as it appears in Search Console.
# Examples: "https://omniflow.us/"  or  "sc-domain:omniflow.us"
GSC_SITE_URL=
