# --- Notion connection (server-side only; never exposed to the browser) ---
# Create a Notion *internal integration* (notion.so/my-integrations), then share
# the CRM, Aggregated Fulfillment, and Projects databases with that integration.
NOTION_TOKEN=

# Notion API version. Defaults to the data-source API; only change if Notion does.
# NOTION_VERSION=2025-09-03

# Data-source IDs. These default to the OmniFlow workspace in code (lib/notion/config.ts);
# override here only if they change or for a different workspace.
# NOTION_DS_CRM=ec316d3a-aab7-4e1a-a5d5-47b53609f0cb
# NOTION_DS_TASKS=2ea366b4-3c25-8160-b1c2-000bea383912
# NOTION_DS_PROJECTS=703f1b14-04fa-40c2-80f1-418e4db49eb8

# --- App auth ---
# Secret used to sign client session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# PHASE 1 client login gate: a shared password that lets any valid client email
# (one that exists in the CRM "Contact Email") sign in. Placeholder until a real
# per-client credential store is wired. Leave unset to disable client login.
CLIENT_ACCESS_PASSWORD=
